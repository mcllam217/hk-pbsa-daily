  "title": "需求推算框架（床位）",
  "method": "以非本地全日制學生做主幹，可加本地一年級；人數 × 住宿 capturerate − 供應＝缺口。有來源先填數；capture rate、增長率未定標「待你定／未披露」，唔估數。上方「需求」四項係唔同口徑，唔相加。",
  "formula": {
    "zh": "床位需求 ≈（非本地全日制 ± 本地一年級）× 住宿比例；缺口 ≈ 床位需求 −（大學宿＋已營運私營 PBSA＋折扣後管道）"
  },
  "steps": [
    {
      "id": "step1",
      "title": "1. 需求池（人數）",
      "inputs": [
        {
          "id": "nonlocal_ft",
          "label": "非本地全日制學生（主幹）",
          "value": 79300,
          "unit": "名",
          "as_of": "2024/25",
          "status": "sourced",
          "source_name": "立法會發展事務委員會 CB(1)1068/2025(03)",
          "source_url": "https://www.legco.gov.hk/yr2025/chinese/panels/dev/papers/dev20250624cb1-1068-3-c.pdf",
          "note": "報讀人數；四年間倍增至約 79,300。"
        },
        {
          "id": "ft_ug_pg",
          "label": "全日制本＋研總人數（對照）",
          "value": 192000,
          "unit": "名",
          "as_of": "2024/25",
          "status": "sourced",
          "source_name": "立法會發展事務委員會 CB(1)1068/2025(03)",
          "source_url": "https://www.legco.gov.hk/yr2025/chinese/panels/dev/papers/dev20250624cb1-1068-3-c.pdf",
          "note": "本地＋非本地；唔等於全部要 PBSA 床。"
        },
        {
          "id": "fyfd",
          "label": "教資會一年級學額 FYFD（流量上限參考）",
          "value": 15000,
          "unit": "個／學年",
          "as_of": "2025-02",
          "status": "sourced",
          "source_name": "立法會參考資料摘要 EDB(HE)CR 7/2041/19",
          "source_url": "https://www.legco.gov.hk/yr2025/english/brief/edbhecr7204119_20250226-e.pdf",
          "note": "本地一年級額度參考；唔當全市場需求。"
        },
        {
          "id": "quota_40",
